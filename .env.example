# ── Anthropic (cliente) ───────────────────────────────────────────────────────
# Usado en el frontend para verificar que la clave existe antes de llamar a la API.
VITE_ANTHROPIC_API_KEY=sk-ant-...

# ── Anthropic (servidor) ──────────────────────────────────────────────────────
# Usado por /api/anthropic.js (Vercel serverless). Nunca se expone al cliente.
ANTHROPIC_API_KEY=sk-ant-...

# ── Supabase ──────────────────────────────────────────────────────────────────
# Obtenlos en: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://<project-id>.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
# Solo servidor (nunca exponer al cliente). Usado por los cron jobs.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Push Notifications (VAPID) ────────────────────────────────────────────────
# Genera las keys con: npx web-push generate-vapid-keys
# VITE_VAPID_PUBLIC_KEY se expone al cliente (prefijo VITE_ necesario).
# VAPID_PRIVATE_KEY es secreta — solo en .env.local y Vercel, nunca en el repo.
VITE_VAPID_PUBLIC_KEY=B...
VAPID_PUBLIC_KEY=B...
VAPID_PRIVATE_KEY=...
VAPID_EMAIL=mailto:tu@email.com

# ── Cron secret (Vercel) ──────────────────────────────────────────────────────
# Cadena aleatoria segura. Vercel la inyecta como Bearer token al disparar el cron.
# Genera con: openssl rand -hex 32   (o cualquier string largo aleatorio)
CRON_SECRET=...
